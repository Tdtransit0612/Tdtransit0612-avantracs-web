# ─────────────────────────────────────────────────────────────────────────────
# Avantra Carrier Services — marketing site (avantracs.com)
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL — used for canonical tags, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://avantracs.com

# Where the "Client Login" button sends people (the TMS).
NEXT_PUBLIC_APP_URL=https://avantracs.app

# ── Lead capture ─────────────────────────────────────────────────────────────
# The contact form writes to the SAME Supabase project the TMS uses, so a lead
# lands in your queue rather than an inbox. Server-only: the service key is never
# shipped to the browser, and this site creates no client-side Supabase client.
# Leave blank and the form falls back to email-only (see RESEND_* below).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notification (optional) ────────────────────────────────────────────
# Pings you when a lead comes in. The lead is stored regardless.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEAD_NOTIFY_EMAIL=

# ── Contact details shown on the site ────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
